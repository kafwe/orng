{
  "name": "orng-vscode",
  "displayName": "orng for VS Code",
  "publisher": "kafwe",
  "description": "Cloudflare-inspired orng light + dark themes for Visual Studio Code.",
  "version": "0.1.3",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "cloudflare",
    "workers",
    "dark",
    "light"
  ],
  "icon": "media/icon-v2.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kafwe/orng.git"
  },
  "bugs": {
    "url": "https://github.com/kafwe/orng/issues"
  },
  "license": "Apache-2.0",
  "contributes": {
    "themes": [
      {
        "label": "orng Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/orng-dark-color-theme.json"
      },
      {
        "label": "orng Light",
        "uiTheme": "vs",
        "path": "./themes/orng-light-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-themes.mjs",
    "test": "node scripts/build-themes.mjs --check",
    "package": "npm run build && npm test && npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish"
  }
}
